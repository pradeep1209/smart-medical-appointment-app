NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
ALLOW_LAN_DEV=false
# Trusted Wi-Fi/hotspot: run tools/configure-wifi.ps1 -TrustPrivateNetwork as administrator.
# It sets API_LAN_ADDRESS=auto and API_LAN_INTERFACES to approved adapter names.
WEB_ORIGIN=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://careslot_app:REPLACE_ME@127.0.0.1:5432/careslot
MIGRATION_DATABASE_URL=postgresql://careslot_owner:REPLACE_ME@127.0.0.1:5432/careslot
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@careslot.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CLINIC_NAME=CareSlot Clinic
ATTENDANCE_MODEL_ENABLED=true
