{
  "name": "careslot", "version": "0.1.0", "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": {"node": ">=24.0.0 <25"},
  "overrides": { "multer": "2.5.0" },
  "scripts": {
    "postinstall": "node tools/check-runtime-dependencies.cjs",
    "check:runtime": "node tools/check-runtime-dependencies.cjs",
    "dev:api": "npm run dev --workspace @careslot/api",
    "dev:web": "npm run dev --workspace @careslot/web",
    "build:api": "npm run build --workspace @careslot/api",
    "build:web": "npm run build --workspace @careslot/web",
    "db:generate": "npm run db:generate --workspace @careslot/api",
    "db:migrate": "npm run db:migrate --workspace @careslot/api",
    "db:seed": "npm run db:seed --workspace @careslot/api"
  }
}
